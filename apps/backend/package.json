    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/platform-socket.io": "^11.0.5",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^7.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.5",
    "axios": "^1.12.2",
